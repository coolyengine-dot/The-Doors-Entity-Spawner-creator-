local function giveCrucifix()
 local backpack=player:WaitForChild('Backpack')
 local old=backpack:FindFirstChild('Crucifix') or (player.Character and player.Character:FindFirstChild('Crucifix'))
 if old then old:Destroy() end
 local tool=Instance.new('Tool')
 tool.Name='Crucifix'; tool.ToolTip='Equip and tap to banish the closest spawned entity (65 studs)'
 tool.RequiresHandle=true; tool.CanBeDropped=false
 local handle=Instance.new('Part'); handle.Name='Handle'; handle.Size=Vector3.new(.35,2.5,.35)
 handle.Material=Enum.Material.Wood; handle.Color=Color3.fromRGB(100,65,38); handle.CanCollide=false; handle.Parent=tool
 local arm=Instance.new('Part'); arm.Name='Crossbar'; arm.Size=Vector3.new(1.7,.35,.35)
 arm.Material=Enum.Material.Wood; arm.Color=handle.Color; arm.CanCollide=false; arm.Massless=true; arm.Parent=tool
 local weld=Instance.new('WeldConstraint'); weld.Part0=handle; weld.Part1=arm; weld.Parent=arm
 arm.CFrame=handle.CFrame*CFrame.new(0,.45,0)
 local glow=Instance.new('PointLight'); glow.Color=Color3.fromRGB(80,190,255); glow.Brightness=.7; glow.Range=8; glow.Parent=handle
 local busy=false
 tool.Activated:Connect(function()
  if busy then return end
  local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  if not root then return end
  local nearest,dist=nil,CRUCIFIX_RANGE
  for _,model in ipairs(folder:GetChildren()) do
   local part=model:IsA('Model') and model.PrimaryPart
   if part and model.Name~='Mad Ambush' and not model:GetAttribute('CrucifixImmune') then
    local d=(part.Position-root.Position).Magnitude
    if d<dist then nearest=model; dist=d end
   end
  end
  if not nearest then return end
  busy=true
  local part=nearest.PrimaryPart
  if part then
   local burst=Instance.new('ParticleEmitter'); burst.Color=ColorSequence.new(Color3.fromRGB(75,200,255))
   burst.LightEmission=1; burst.Rate=0; burst.Speed=NumberRange.new(10,18)
