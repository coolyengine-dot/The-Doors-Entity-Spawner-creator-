-- Rebound path helper: follows the same CurrentRooms.Nodes path as Rush, but in reverse.
local function getReboundReversePath()
 local rooms=workspace:FindFirstChild("CurrentRooms")
 if not rooms then error("CurrentRooms folder is missing") end
 local numberedRooms={}
 for _,room in ipairs(rooms:GetChildren()) do
  local roomNumber=tonumber(room.Name)
  if roomNumber then table.insert(numberedRooms,{Number=roomNumber,Room=room}) end
 end
 table.sort(numberedRooms,function(a,b) return a.Number>b.Number end)
 local path={}
 for _,entry in ipairs(numberedRooms) do
  local nodes=entry.Room:FindFirstChild("Nodes")
  if nodes then
   local roomNodes={}
   for _,node in ipairs(nodes:GetChildren()) do
    if node:IsA("BasePart") then table.insert(roomNodes,node) end
   end
   table.sort(roomNodes,function(a,b) return (tonumber(a.Name) or 0)>(tonumber(b.Name) or 0) end)
   for _,node in ipairs(roomNodes) do table.insert(path,node) end
  end
 end
 if #path==0 then error("No Rush path nodes found in CurrentRooms.*.Nodes") end
 return path
end

local function moveReboundAlongReversePath(model,path,speed,heightOffset,delay)
 local chosenSpeed=math.max(1,tonumber(speed) or 450)
 for _,node in ipairs(path) do
  if not model.Parent then return false end
  local target=node.CFrame+CFrame.new(0,3.5+(tonumber(heightOffset) or 0),0)
  local start=model:GetPivot()
  local distance=(start.Position-target.Position).Magnitude
  local duration=math.max(0.05,distance/chosenSpeed)
  local driver=Instance.new("CFrameValue")
  driver.Value=start
  local connection=driver:GetPropertyChangedSignal("Value"):Connect(function()
   if model.Parent then model:PivotTo(driver.Value) end
  end)
  local tween=TweenService:Create(driver,TweenInfo.new(duration,Enum.EasingStyle.Linear),{Value=target})
  tween:Play(); tween.Completed:Wait()
  connection:Disconnect(); driver:Destroy()
  if delay and delay>0 then task.wait(delay) end
 end
 return model.Parent~=nil
end

