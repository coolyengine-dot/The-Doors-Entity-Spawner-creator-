-- Hotel Minus legacy spawner does not implement V2 Lights.Repair.
-- Save local light state and restore it when its room traversal finishes.
local function minusCaptureLights()
 local snapshot={}
 local rooms=workspace:FindFirstChild('CurrentRooms')
 if not rooms then return snapshot end
 for _,obj in ipairs(rooms:GetDescendants()) do
  if obj:IsA('PointLight') or obj:IsA('SpotLight') or obj:IsA('SurfaceLight') then
   snapshot[#snapshot+1]={object=obj,enabled=obj.Enabled,brightness=obj.Brightness,color=obj.Color,range=obj.Range}
  end
 end
 return snapshot
end
local function minusRestoreLights(snapshot)
 local restored=0
 for _,entry in ipairs(snapshot) do
  local obj=entry.object
  if obj and obj.Parent then
   local ok=pcall(function()
    obj.Enabled=entry.enabled
    obj.Brightness=entry.brightness
    obj.Color=entry.color
    obj.Range=entry.range
   end)
   if ok then restored=restored+1 end
  end
 end
 print('[Hotel Minus] Restored '..restored..' lights (local visual repair).')
end

