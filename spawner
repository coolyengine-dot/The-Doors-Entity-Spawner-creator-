local function spawnRipper()
 local ok,err=pcall(function()
  local loaded=game:GetObjects('rbxassetid://11580358412')[1]
  assert(loaded, 'Ripper model could not be loaded')
  loaded.Name='Ripper'; trackEntityModel(loaded); loaded.Parent=folder
  local ripper=loaded:FindFirstChild('Ripe',true)
  assert(ripper and ripper:IsA('BasePart'), 'Ripper asset is missing Ripe part')
  ripper.Anchored=true; ripper.CanCollide=false
  local char=player.Character; local root=char and char:FindFirstChild('HumanoidRootPart')
  assert(root, 'Character not ready')
  ripper.CFrame=getSpawnCFrame(root) + Vector3.new(0,5,0)
  local sound=ripper:FindFirstChild('Ambush')
  if sound and sound:IsA('Sound') then
   sound.SoundId='rbxassetid://6963538865'; sound.Volume=5; sound.PlaybackSpeed=.37; sound:Play()
  end
  local rooms=workspace:FindFirstChild('CurrentRooms')
  if rooms then
   for _,v in ipairs(rooms:GetDescendants()) do
    if v:IsA('Light') then
     TweenService:Create(v,TweenInfo.new(3),{Color=Color3.fromRGB(255,0,34)}):Play()
    end
   end
  end
  local done=false
  task.spawn(function()
   local function moveTo(pos)
    if done or not ripper.Parent then return end
    local dist=(ripper.Position-pos).Magnitude
    local tween=TweenService:Create(ripper,TweenInfo.new(math.max(.03,dist/100),Enum.EasingStyle.Linear),{CFrame=CFrame.new(pos)})
    tween:Play(); tween.Completed:Wait()
   end
   if rooms then
    local numbered={}
    for _,room in ipairs(rooms:GetChildren()) do
     local n=tonumber(room.Name)
     if n then table.insert(numbered,{n=n,room=room}) end
    end
    table.sort(numbered,function(a,b) return a.n<b.n end)
    for _,entry in ipairs(numbered) do
     if done then break end
     local nodes=entry.room:FindFirstChild('Nodes')
     if nodes then
      local sorted=nodes:GetChildren()
      table.sort(sorted,function(a,b) return (tonumber(a.Name) or 0)<(tonumber(b.Name) or 0) end)
      for _,node in ipairs(sorted) do
       if done then break end
       if node:IsA('BasePart') then moveTo(node.Position+Vector3.new(0,5,0)) end
      end
     end
    end
   else
    moveTo(root.Position + root.CFrame.LookVector*8+Vector3.new(0,5,0))
   end
   done=true
   if loaded.Parent then loaded:Destroy() end
  end)
  task.spawn(function()
   while not done and loaded.Parent and ripper.Parent do
    task.wait(.1)
    local character=player.Character
    local hrp=character and character:FindFirstChild('HumanoidRootPart')
    local hum=character and character:FindFirstChildWhichIsA('Humanoid')
    if hrp and hum and hum.Health>0 and not character:GetAttribute('Hiding') then
     local delta=hrp.Position-ripper.Position
     if delta.Magnitude<=50 then
      local rayParams=RaycastParams.new()
      rayParams.FilterType=Enum.RaycastFilterType.Exclude
      rayParams.FilterDescendantsInstances={loaded}
      local hit=workspace:Raycast(ripper.Position,delta,rayParams)
      if hit and hit.Instance:IsDescendantOf(character) then
       done=true
       -- Local death effect; in multiplayer the server may not accept local damage.
       if editorSetting('Damage',true) then hum:TakeDamage(tonumber(editorSetting('DamageAmount',100)) or 100) end
       warn('Ripper caught you! Hide when the lights turn red.')
       if loaded.Parent then loaded:Destroy() end
       break
      end
     end
    end
   end
  end)
 end)
 if not ok then warn('Ripper spawn failed: '..tostring(err)) end
 return ok
end
