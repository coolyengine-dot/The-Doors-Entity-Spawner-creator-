-- Universal client-side creator: does not depend on DOORS rooms or modules.
local universalEntities = {}
local function universalStop()
 for _, record in ipairs(universalEntities) do
  record.alive = false
  if record.model and record.model.Parent then record.model:Destroy() end
 end
 table.clear(universalEntities)
end
local function universalSpawn()
 local cfg=creatorCopy(creatorConfig)
 task.spawn(function()
  local ok,err=pcall(function()
   local players=game:GetService('Players')
   local runService=game:GetService('RunService')
   local lp=players.LocalPlayer
   local char=lp.Character or lp.CharacterAdded:Wait()
   local root=char:WaitForChild('HumanoidRootPart',10)
   if not root then error('Character root not found') end
   local model, primary
   local asset=tostring(cfg.AssetId or '')
   local numeric=asset:match('^%d+$') or asset:match('^rbxassetid://(%d+)$')
   if numeric then
    local success,objects=pcall(function() return game:GetObjects('rbxassetid://'..numeric) end)
    if success and objects and objects[1] then
     local obj=objects[1]
     if obj:IsA('Model') then model=obj
     elseif obj:IsA('BasePart') then
      model=Instance.new('Model')
      obj.Parent=model
     end
    end
   end
   if not model and type(LoadCustomInstance)=='function' and asset~='' then
    local loadedOk, loaded=pcall(LoadCustomInstance,asset)
    if loadedOk and typeof(loaded)=='Instance' then
     if loaded:IsA('Model') then model=loaded
     elseif loaded:IsA('BasePart') then
      model=Instance.new('Model')
      loaded.Parent=model
     end
    end
   end
   if not model then
    error('Could not load custom entity model: '..asset..'. Supply a valid accessible asset ID or model URL with a supported LoadCustomInstance loader. No placeholder will spawn.')
   end
   model.Name=tostring(cfg.Name or 'Custom Entity')
   primary=model.PrimaryPart or model:FindFirstChildWhichIsA('BasePart',true)
   if not primary then error('Entity model has no BasePart') end
   model.PrimaryPart=primary
   for _,part in ipairs(model:GetDescendants()) do
    if part:IsA('BasePart') then part.Anchored=true; part.CanCollide=false end
   end
   local forward=root.CFrame.LookVector
   local offset=tonumber(cfg.HeightOffset) or 0
   local start=root.Position-forward*65+Vector3.new(0,offset,0)
   local finish=root.Position+forward*65+Vector3.new(0,offset,0)
   if cfg.Reversed then start,finish=finish,start end
   trackEntityModel(model); model.Parent=workspace
   model:PivotTo(CFrame.new(start))
   local record={model=model,alive=true}
   table.insert(universalEntities,record)
   task.wait(math.max(0,tonumber(cfg.Delay) or 0))
   local speed=math.max(1,tonumber(cfg.Speed) or 100)
   local totalCycles=cfg.Rebounding and math.clamp(math.random(math.max(1,math.floor(tonumber(cfg.MinRebound) or 1)),math.max(1,math.floor(tonumber(cfg.MaxRebound) or 1))),1,20) or 1
   local from,to=start,finish
   for cycle=1,totalCycles do
    local pos=from
    while record.alive and model.Parent and (to-pos).Magnitude>0.15 do
     local dt=runService.Heartbeat:Wait()
     local delta=to-pos
     pos=pos+delta.Unit*math.min(delta.Magnitude,speed*dt)
     model:PivotTo(CFrame.lookAt(pos,pos+forward))
     if cfg.Damage then
      local activeChar=lp.Character
      local activeRoot=activeChar and activeChar:FindFirstChild('HumanoidRootPart')
      local humanoid=activeChar and activeChar:FindFirstChildOfClass('Humanoid')
      if activeRoot and humanoid and (activeRoot.Position-pos).Magnitude <= (tonumber(cfg.DamageRange) or 15) then
       -- Client-side damage is local only; server games may reject it.
       humanoid:TakeDamage(math.max(0,tonumber(cfg.DamageAmount) or 0))
       cfg.Damage=false
      end
     end
    end
    if not record.alive then break end
    from,to=to,from
    if cycle<totalCycles then task.wait(math.max(0,tonumber(cfg.ReboundDelay) or 0)) end
   end
   record.alive=false
   if model.Parent then model:Destroy() end
  end)
  if not ok then warn('[Universal Entity Creator] '..tostring(err)) end
 end)
end

-- Hotel Minus legacy spawner (provided source), loaded only on demand.
local hotelMinusSource = [====[
-- Services

local Players = game:GetService("Players")
local ReSt = game:GetService("ReplicatedStorage")
