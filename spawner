-- Universal spawn origin: supports Rooms, Hotel, Mines, Backdoor, Retro and custom subfloors.
-- Uses the player's live position, not a hard-coded room number or floor coordinate.
local function getSpawnCFrame(root)
 local rooms = workspace:FindFirstChild('CurrentRooms')
 if universalFloorSpawning and rooms then
  local best, bestDist
  for _, room in ipairs(rooms:GetChildren()) do
   if room:IsA('Model') then
    local candidate = room:FindFirstChild('RoomEntrance',true) or room:FindFirstChild('Door',true)
    local part = candidate and (candidate:IsA('BasePart') and candidate or candidate:FindFirstChildWhichIsA('BasePart',true))
    if part then
     local dist = (part.Position-root.Position).Magnitude
     if not bestDist or dist<bestDist then best,bestDist=part,dist end
    end
   end
  end
  if best and bestDist and bestDist<160 then
   local direction=root.Position-best.Position
   direction=Vector3.new(direction.X,0,direction.Z)
   if direction.Magnitude>0.01 then
    local pos=root.Position-direction.Unit*floorSpawnDistance+Vector3.new(0,3,0)
    return CFrame.lookAt(pos,root.Position+Vector3.new(0,3,0))
   end
  end
 end
 return root.CFrame*CFrame.new(0,3,-floorSpawnDistance)
end
