     model=Instance.new('Model'); part.Parent=model
    end
   end
   model.Name='A-400'; trackEntityModel(model); model.Parent=workspace
   local parts={}
   for _,obj in ipairs(model:GetDescendants()) do
    if obj:IsA('BasePart') then obj.Anchored=true; obj.CanCollide=false; table.insert(parts,obj) end
   end
   if #parts==0 then model:Destroy(); error('A-400 model contains no BaseParts') end

   local data=game:GetService('ReplicatedStorage'):WaitForChild('GameData',5)
   local latest=data and data:FindFirstChild('LatestRoom')
   local rooms=workspace:FindFirstChild('CurrentRooms')
   if not (latest and rooms) then model:Destroy(); error('CurrentRooms or GameData.LatestRoom missing') end
   local room=rooms:FindFirstChild(tostring(latest.Value))
   if not room then model:Destroy(); error('Could not find the current room for A-400') end

   local floorPart
   local bestArea=0
   for _,obj in ipairs(room:GetDescendants()) do
    if obj:IsA('BasePart') and obj.Size.X>8 and obj.Size.Z>8 and obj.Size.Y<8 then
     local area=obj.Size.X*obj.Size.Z
     local name=obj.Name:lower()
     if area>bestArea or (name:find('floor') and not (floorPart and floorPart.Name:lower():find('floor'))) then
      floorPart=obj; bestArea=area
     end
    end
   end
   local boundsCFrame,boundsSize=room:GetBoundingBox()
   local function randomRoomCFrame()
    local height=tonumber(editorSetting('HeightOffset',0)) or 0
    if floorPart then
     local x=(math.random()-0.5)*math.max(2,floorPart.Size.X*0.72)
     local z=(math.random()-0.5)*math.max(2,floorPart.Size.Z*0.72)
     return floorPart.CFrame*CFrame.new(x,floorPart.Size.Y/2+3.5+height,z)
    end
    local x=(math.random()-0.5)*math.max(4,boundsSize.X*0.45)
    local z=(math.random()-0.5)*math.max(4,boundsSize.Z*0.45)
    return boundsCFrame*CFrame.new(x,-boundsSize.Y/2+3.5+height,z)
   end
   local function doorIsOpen()
    local door=room:FindFirstChild('Door',true)
    if not door then return false end
    local function truthy(v) return v==true or v==1 or v=='true' end
    for _,obj in ipairs({door,table.unpack(door:GetDescendants())}) do
     for _,key in ipairs({'Open','Opened','IsOpen'}) do
      local value=obj:GetAttribute(key)
      if truthy(value) then return true end
     end
     if (obj:IsA('BoolValue') or obj:IsA('IntValue') or obj:IsA('StringValue')) and
        (obj.Name:lower()=='open' or obj.Name:lower()=='opened' or obj.Name:lower()=='isopen') and truthy(obj.Value) then
      return true
     end
     if obj:IsA('HingeConstraint') and math.abs(obj.CurrentAngle)>20 then return true end
    end
    return false
   end
   model:PivotTo(randomRoomCFrame())
   local originalRoom=latest.Value
   while model.Parent and latest.Value==originalRoom and not doorIsOpen() do
    task.wait(math.random(15,30)/10)
    if model.Parent and latest.Value==originalRoom and not doorIsOpen() then model:PivotTo(randomRoomCFrame()) end
   end
   if model.Parent then model:Destroy() end
  end)
  if not ok then warn('[A-400] Room-stayer failed: '..tostring(err)) end
 end)
 return true
end
