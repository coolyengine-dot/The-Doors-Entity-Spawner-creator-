   Jumpscare={true,{
    Image1='rbxassetid://14629487251',Image2='rbxassetid://14629487251',Shake=false,
    Sound1={10483790459,{Volume=0.5}},Sound2={10483837590,{Volume=0.5}},
    Flashing={true,Color3.fromRGB(0,255,255)},Tease={false,Min=1,Max=4}
   }},
   CustomDialog={'You died to an entity called Depth.','Hide when the lights flicker.','Depth will chase you if you stay exposed.'}
  })
  local chaseConnection
  local function stopChase()
   if chaseConnection then chaseConnection:Disconnect(); chaseConnection=nil end
  end
  local function isHiding(character)
   if not character then return false end
   for _,attribute in ipairs({'Hiding','IsHiding','Hidden','InCloset'}) do
    if character:GetAttribute(attribute)==true then return true end
   end
   local hiding=character:FindFirstChild('Hiding') or character:FindFirstChild('IsHiding')
   if hiding and hiding:IsA('BoolValue') then return hiding.Value end
   local hum=character:FindFirstChildOfClass('Humanoid')
   return hum and hum.SeatPart and (hum.SeatPart.Name:lower():find('hide')~=nil or hum.SeatPart.Name:lower():find('closet')~=nil) or false
  end
  if entity.Debug then
   entity.Debug.OnEntitySpawned=function()
    print('Depth spawned (nonlethal)')
    stopChase()
    chaseConnection=RunService.Heartbeat:Connect(function(dt)
     local character=player.Character
     local target=character and character:FindFirstChild('HumanoidRootPart')
     if not target or isHiding(character) then return end
     local model=entity.Model
     if typeof(model)~='Instance' then return end
     local part=model:IsA('BasePart') and model or (model:IsA('Model') and (model.PrimaryPart or model:FindFirstChildWhichIsA('BasePart',true)))
     if not part then return end
     local delta=target.Position-part.Position
     if delta.Magnitude<4 or delta.Magnitude>160 then return end
     local step=math.min(delta.Magnitude-3,90*dt)
     local nextPosition=part.Position+delta.Unit*step
     if model:IsA('Model') then model:PivotTo(CFrame.lookAt(nextPosition,target.Position))
     else part.CFrame=CFrame.lookAt(nextPosition,target.Position) end
    end)
   end
   entity.Debug.OnEntityDespawned=stopChase
   entity.Debug.OnDeath=function() warn('Depth is configured as nonlethal') end
  end
  depthSpawner.runEntity(entity)
 end)
 if not ok then warn('Depth failed: '..tostring(err)) end
 return ok
end

