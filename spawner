-- GitHub Crucifix (user-supplied Vynixu model and chains).
-- Client-side banishment of local custom entities only; Mad Ambush is immune.
local function giveGitHubCrucifix()
 local backpack=player:WaitForChild('Backpack')
 local ok,tool=pcall(function() return game:GetObjects('rbxassetid://11803111436')[1] end)
 if not ok or not tool or not tool:IsA('Tool') then
  warn('GitHub Crucifix model unavailable (11803111436)')
  return nil
 end
 tool.Name='GitHub Crucifix'
 tool.CanBeDropped=false
 tool.ToolTip='Look at a custom entity within 25 studs to banish it. Mad Ambush is immune.'
 local handle=tool:FindFirstChild('Handle')
 if not handle then warn('GitHub Crucifix has no Handle'); tool:Destroy(); return nil end
 local equipped=false
 local used=false
 local connections={}
 local function entityPart(obj)
  if obj:IsA('BasePart') then return obj end
  if obj:IsA('Model') then return obj.PrimaryPart or obj:FindFirstChild('RushNew',true) or obj:FindFirstChildWhichIsA('BasePart',true) end
 end
 local function isImmune(obj)
  if obj.Name=='Mad Ambush' or obj:GetAttribute('CrucifixImmune') then return true end
  local n=obj.Name:lower()
  if n:find('mad ambush',1,true) then return true end
  return false
 end
 local function visible(part,char)
  local camera=workspace.CurrentCamera
  if not camera then return false end
  local point,onScreen=camera:WorldToViewportPoint(part.Position)
  if not onScreen or point.Z<=0 then return false end
  local params=RaycastParams.new()
  params.FilterType=Enum.RaycastFilterType.Exclude
  params.FilterDescendantsInstances={char,tool}
  local origin=camera.CFrame.Position
  local ray=workspace:Raycast(origin,part.Position-origin,params)
  return not ray or ray.Instance:IsDescendantOf(part.Parent)
 end
 local function banish(target,part)
  if used or isImmune(target) then return end
  used=true
  local chains
  pcall(function()
   chains=game:GetObjects('rbxassetid://11803106473')[1]
   chains.Parent=workspace
   if chains:IsA('Model') then chains:PivotTo(part.CFrame*CFrame.new(0,-3.5,0)) end
   local attachment=Instance.new('Attachment'); attachment.Name='GitHubCrucifixTarget'; attachment.Parent=part
   for _,obj in ipairs(chains:GetDescendants()) do
    if obj:IsA('Beam') then obj.Attachment1=attachment end
    if obj:IsA('BasePart') then obj.CanCollide=false end
   end
  end)
  local burst=Instance.new('ParticleEmitter')
  burst.Color=ColorSequence.new(Color3.fromRGB(75,177,255))
  burst.LightEmission=1; burst.Rate=0; burst.Speed=NumberRange.new(7,14)
  burst.Lifetime=NumberRange.new(.3,.7); burst.Parent=part; burst:Emit(80)
  local light=Instance.new('PointLight'); light.Color=Color3.fromRGB(75,177,255)
  light.Brightness=8; light.Range=25; light.Parent=part
  pcall(function() part.Anchored=true end)
  pcall(function() game:GetService('TweenService'):Create(part,TweenInfo.new(1.5),{CFrame=part.CFrame*CFrame.new(0,35,0)}):Play() end)
  task.delay(1.6,function()
   if target.Parent then target:Destroy() end
   if chains then chains:Destroy() end
   if tool.Parent then tool:Destroy() end
  end)
 end
 local function check()
  if not equipped or used then return end
  local char=player.Character
  local root=char and char:FindFirstChild('HumanoidRootPart')
  if not root then return end
  local nearest,part,dist=nil,nil,25
  local candidates={}
  for _,obj in ipairs(folder:GetChildren()) do table.insert(candidates,obj) end
  for _,obj in ipairs(workspace:GetChildren()) do
   if obj~=folder and obj:GetAttribute('IsCustomEntity')==true then table.insert(candidates,obj) end
  end
  for _,obj in ipairs(candidates) do
   if obj.Parent and not isImmune(obj) and obj~=char then
    local candidate=entityPart(obj)
    if candidate and candidate:IsA('BasePart') then
     local d=(candidate.Position-root.Position).Magnitude
     if d<dist and visible(candidate,char) then nearest,part,dist=obj,candidate,d end
    end
   end
  end
  if nearest then banish(nearest,part) end
 end
 table.insert(connections,tool.Equipped:Connect(function() equipped=true end))
 table.insert(connections,tool.Unequipped:Connect(function() equipped=false end))
 table.insert(connections,game:GetService('RunService').Heartbeat:Connect(check))
 tool.Destroying:Connect(function() for _,connection in ipairs(connections) do connection:Disconnect() end end)
 tool.Parent=backpack
 return tool
end

