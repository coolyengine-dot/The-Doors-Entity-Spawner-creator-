-- Frostbite: GitHub model, cold damage until player advances to the next room.
-- Requires executor support for request/writefile/getcustomasset.
local function spawnFrostbite()
 local ok,err=pcall(function()
  local url='https://github.com/fernandesdasilvamariainez-coder/Roblox-Doors-Custom-Entities/blob/main/Frost.txt?raw=true'
  local httpRequest=request or http_request or (syn and syn.request)
  local assetLoader=getcustomasset or getsynasset
  if not (httpRequest and writefile and assetLoader) then warn('Frostbite needs request, writefile and custom assets'); return end
  local filename='doors_frostbite_model.rbxm'
  if not (isfile and isfile(filename)) then
   local response=httpRequest({Url=url,Method='GET'})
   if not response or response.StatusCode~=200 then warn('Frostbite model download failed'); return end
   writefile(filename,response.Body)
  end
  local model=game:GetObjects(assetLoader(filename))[1]
  if not model then warn('Frostbite model unavailable'); return end
  local part=model:FindFirstChild('Part',true)
  if not part or not part:IsA('BasePart') then warn('Frostbite model missing Part'); model:Destroy(); return end
  local rooms=workspace:FindFirstChild('CurrentRooms')
  local gameData=game:GetService('ReplicatedStorage'):FindFirstChild('GameData')
  local latestRoom=gameData and gameData:FindFirstChild('LatestRoom')
  if not (rooms and latestRoom) then warn('Frostbite needs CurrentRooms and LatestRoom'); model:Destroy(); return end
  local startRoom=latestRoom.Value
  local room=rooms:FindFirstChild(tostring(startRoom))
  local nodes=room and room:FindFirstChild('Nodes')
  trackEntityModel(model); model.Parent=workspace
  if nodes then
   local points={}
   for _,node in ipairs(nodes:GetChildren()) do if node:IsA('BasePart') then table.insert(points,node) end end
   if #points>0 then part.CFrame=points[math.random(#points)].CFrame*CFrame.new(math.random(5,10),6,math.random(5,10)) end
  end
  local active=true
  local function play(name)
   local sound=part:FindFirstChild(name,true)
   if sound and sound:IsA('Sound') then sound:Play() end
  end
  local function setEffects(enabled)
   for _,name in ipairs({'Heylois','face','BlackTrail'}) do
    local effect=part:FindFirstChild(name,true)
    if effect and (effect:IsA('ParticleEmitter') or effect:IsA('Beam') or effect:IsA('Trail')) then effect.Enabled=enabled end
   end
  end
  play('Static Effect')
  task.wait(8.13)
  if not model.Parent or latestRoom.Value~=startRoom then active=false end
  if active then
   setEffects(true); play('Ambience'); play('AmbienceFar')
   task.spawn(function()
    task.wait(1.3)
    while active and model.Parent and latestRoom.Value==startRoom do
     local char=player.Character
     local humanoid=char and char:FindFirstChildOfClass('Humanoid')
     if humanoid and humanoid.Health>0 then
      local hasHeat=false
      for _,name in ipairs({'Lighter'}) do
       local tool=char:FindFirstChild(name)
       if tool then
        for _,light in ipairs(tool:GetDescendants()) do
         if light:IsA('PointLight') and light.Enabled then hasHeat=true; break end
        end
       end
       if hasHeat then break end
      end
      if not hasHeat and editorSetting('Damage',true) then humanoid:TakeDamage(tonumber(editorSetting('DamageAmount',5)) or 5) end
     end
     task.wait(1)
    end
   end)
   while model.Parent and latestRoom.Value==startRoom do task.wait(.2) end
  end
  active=false
  setEffects(false)
  for _,name in ipairs({'Ambience','AmbienceFar'}) do
   local snd=part:FindFirstChild(name,true)
   if snd and snd:IsA('Sound') then snd:Stop() end
  end
  play('Despawn')
  task.wait(6)
  if model.Parent then model:Destroy() end
 end)
 if not ok then warn('Frostbite error: '..tostring(err)) end
 return ok
end
