 local function watchHotelMinusDoors(enabled)
  doorRespawnEnabled=enabled
  disconnectRoom()
  if not enabled then print('[Hotel Minus Creator] Door respawn OFF'); return end
  local replicated=game:GetService('ReplicatedStorage')
  local gameData=replicated:FindFirstChild('GameData')
  local latest=gameData and gameData:FindFirstChild('LatestRoom')
  if not latest or not latest:IsA('ValueBase') then
   doorRespawnEnabled=false
   warn('[Hotel Minus Creator] Cannot enable door respawn: GameData.LatestRoom missing')
   return
  end
  lastRoom=latest.Value
  roomConnection=latest:GetPropertyChangedSignal('Value'):Connect(function()
   if not doorRespawnEnabled then return end
   local current=latest.Value
   if current==lastRoom then return end
   lastRoom=current
   if doorBusy then return end
   doorBusy=true
   task.spawn(function()
    local ok,err=pcall(creatorSpawnHotelMinus)
    if not ok then warn('[Hotel Minus Creator] Door spawn error: '..tostring(err)) end
    task.wait(0.3)
    doorBusy=false
   end)
  end)
  print('[Hotel Minus Creator] Door respawn ON')
 end
