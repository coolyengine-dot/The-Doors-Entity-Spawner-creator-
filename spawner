  })
  local Players=game:GetService('Players')
  local RunService=game:GetService('RunService')
  local Debris=game:GetService('Debris')
  local player=Players.LocalPlayer
  local tracking=false
  local connection
  local function stopTracking()
   tracking=false
   if connection then connection:Disconnect(); connection=nil end
  end
  entity:SetCallback('OnSpawned',function()
   print('Hotel+ A-200 spawned')
   task.spawn(function()
    pcall(function()
     local main=require(player.PlayerGui.MainUI.Initiator.Main_Game)
     main.caption('Player : Something isn\'t right',true)
     task.wait(4)
     main.caption('HIDE',true)
    end)
   end)
   task.delay(30,function()
    stopTracking()
    local model=entity.Model
    if model and model.Parent then model:Destroy() end
   end)
  end)
  entity:SetCallback('OnStartMoving',function()
   stopTracking()
   tracking=true
   connection=RunService.Heartbeat:Connect(function(dt)
    if not tracking then return end
    local model=entity.Model
    if not model or not model.Parent then stopTracking(); return end
    local char=player.Character
    if not char or char:GetAttribute('Hiding') then return end
    local hrp=char:FindFirstChild('HumanoidRootPart')
    if not hrp then return end
    local current=model:GetPivot()
    local delta=hrp.Position-current.Position
    local distance=delta.Magnitude
    if distance>0.05 then
     local step=math.min(distance,20*dt)
     local newPosition=current.Position+delta.Unit*step
     model:PivotTo(CFrame.new(newPosition)*current.Rotation)
    end
   end)
  end)
  entity:SetCallback('OnDespawning',stopTracking)
  entity:SetCallback('OnDespawned',stopTracking)
  entity:SetCallback('OnDamagePlayer',function(newHealth)
   if newHealth>0 then return end
   stopTracking()
   local sound=Instance.new('Sound')
   sound.SoundId='rbxassetid://107732855391320'
   sound.Volume=10
   sound.Parent=workspace
   sound:Play()
   Debris:AddItem(sound,6)
   local gui=Instance.new('ScreenGui')
   gui.Name='A200Jumpscare'
   gui.IgnoreGuiInset=true
   gui.DisplayOrder=999999
   gui.ResetOnSpawn=false
   gui.Parent=player:WaitForChild('PlayerGui')
   local image=Instance.new('ImageLabel')
   image.BackgroundTransparency=1
   image.BorderSizePixel=0
   image.Size=UDim2.fromScale(1,1)
   image.Image='rbxassetid://16249498432'
   image.ScaleType=Enum.ScaleType.Stretch
   image.Parent=gui
   task.delay(5,function() if gui.Parent then gui:Destroy() end end)
  end)
  entity:Run(true)
 end)
 if not ok then warn('Hotel+ A-200 failed: '..tostring(err)) end
