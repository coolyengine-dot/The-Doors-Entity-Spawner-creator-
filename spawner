-- Seek: chases the local player and despawns after five room/door advances.
-- Default model is cloned from the live DOORS game when available; the editor Asset ID field can override it.
local function spawnSeekFiveDoors()
 task.spawn(function()
  local ok,err=pcall(function()
   local Players=game:GetService('Players')
   local RunService=game:GetService('RunService')
   local ReplicatedStorage=game:GetService('ReplicatedStorage')
   local player=Players.LocalPlayer
   local data=ReplicatedStorage:WaitForChild('GameData',5)
   local latest=data and data:FindFirstChild('LatestRoom')
   if not latest then error('GameData.LatestRoom is unavailable') end

   local profile=(_G.DOORS_EDITOR_ACTIVE_NAME=='Seek (5 Doors)' and _G.DOORS_EDITOR_ACTIVE_PROFILE) or nil
   local assetId=(type(profile)=='table' and profile.AssetId) or 'DOORS_GAME_SEEK_MODEL'
   local loaded
   if assetId and assetId~='' and assetId~='DOORS_GAME_SEEK_MODEL' then
    local assetText=tostring(assetId)
    if assetText:match('^%d+$') then assetText='rbxassetid://'..assetText end
    local objects=game:GetObjects(assetText)
    loaded=objects and objects[1]
    if not loaded then error('Custom Seek model did not load: '..assetText) end
   else
    local containers={ReplicatedStorage,workspace}
    for _,container in ipairs(containers) do
     for _,obj in ipairs(container:GetDescendants()) do
      if obj.Name:lower()=='seek' and (obj:IsA('Model') or obj:IsA('BasePart')) then
       loaded=obj:Clone(); break
      end
     end
     if loaded then break end
    end
    if not loaded then error('Could not find the live DOORS Seek model. Enter a model asset ID in Entity Editor to override it.') end
   end

   local model
   if loaded:IsA('Model') then model=loaded
   elseif loaded:IsA('BasePart') then model=Instance.new('Model'); loaded.Parent=model
   else
    model=loaded:FindFirstChildWhichIsA('Model',true)
    if not model then
     local part=loaded:FindFirstChildWhichIsA('BasePart',true)
     if not part then loaded:Destroy(); error('Seek asset contains no Model or BasePart') end
     model=Instance.new('Model'); part.Parent=model
    end
   end
   model.Name='Seek (5 Doors)'
   trackEntityModel(model); model.Parent=workspace
   local partCount=0
   for _,obj in ipairs(model:GetDescendants()) do
    if obj:IsA('BasePart') then obj.Anchored=true; obj.CanCollide=false; partCount=partCount+1 end
   end
   if partCount==0 then model:Destroy(); error('Seek model contains no BaseParts') end

   task.wait(math.max(0,tonumber((type(profile)=='table' and profile.Delay) or 0) or 0))
   local function getRoot()
    local char=player and player.Character
    return char and char:FindFirstChild('HumanoidRootPart')
   end
   local root=getRoot()
   if not root then model:Destroy(); error('Player character root is unavailable') end
   local height=tonumber((type(profile)=='table' and profile.HeightOffset) or 0) or 0
   local speed=math.clamp(tonumber((type(profile)=='table' and profile.Speed) or 24) or 24,1,300)
   model:PivotTo(root.CFrame*CFrame.new(0,0,32))

   local doorsPassed=0
   local active=true
   local roomConnection=latest:GetPropertyChangedSignal('Value'):Connect(function()
    doorsPassed=doorsPassed+1
    if doorsPassed>=5 then active=false end
   end)
   local heartbeat
   heartbeat=RunService.Heartbeat:Connect(function(dt)
    if not active or not model.Parent then
     if heartbeat then heartbeat:Disconnect() end
     if roomConnection then roomConnection:Disconnect() end
     if model.Parent then model:Destroy() end
     return
    end
    local targetRoot=getRoot()
    if not targetRoot then return end
    local pivot=model:GetPivot()
    local target=targetRoot.Position+Vector3.new(0,3.5+height,0)
    local offset=target-pivot.Position
    local distance=offset.Magnitude
    if distance>0.05 then
     local step=math.min(distance,speed*dt)
     local nextPos=pivot.Position+offset.Unit*step
     model:PivotTo(CFrame.lookAt(nextPos,targetRoot.Position))
    end
   end)
   task.spawn(function()
    while active and model.Parent do task.wait(0.25) end
    if heartbeat then heartbeat:Disconnect() end
    if roomConnection then roomConnection:Disconnect() end
    if model.Parent then model:Destroy() end
   end)
  end)
  if not ok then warn('[Seek 5 Doors] '..tostring(err)) end
 end)
 return true
end
